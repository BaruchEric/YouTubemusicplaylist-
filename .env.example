# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# GEMINI_ALLOWED_EMAILS: Optional comma-separated Google accounts allowed to use the AI
# endpoints. Unset, any Google account that signs in to the app can use them (rate limited).
# GEMINI_ALLOWED_EMAILS="you@example.com"

# BIND_HOST: Optional listen address. Defaults to 0.0.0.0; use 127.0.0.1 for local-only.
# BIND_HOST="127.0.0.1"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Nothing in this code reads it. A server you run yourself can leave it out.
APP_URL="MY_APP_URL"
